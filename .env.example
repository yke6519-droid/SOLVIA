# ==============================
# 大模型配置
# ==============================

# OpenAI 兼容接口的 API Key
API_KEY=your_api_key

# OpenAI 兼容接口地址
BASE_URL=https://your-openai-compatible-endpoint/v1

# 模型名称，例如 qwen-plus
MODEL_NAME=your_model_name


# ==============================
# 阿里云百炼知识库配置
# ==============================

ALIBABA_CLOUD_ACCESS_KEY_ID=your_access_key_id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_access_key_secret
WORKSPACE_ID=your_workspace_id
BAILIAN_INDEX_ID=your_bailian_index_id

# 百炼服务端点
BAILIAN_ENDPOINT=bailian.cn-beijing.aliyuncs.com


# ==============================
# 数据库配置
# ==============================

# MySQL 连接地址
MYSQL_URL=mysql+pymysql://username:password@localhost:3306/solar_agent?charset=utf8mb4


# ==============================
# 预测模型配置
# ==============================

# 晴天预测模型路径
MODEL_SUNNY=backend/tools/model/sunny_model.h5

# 多云或非晴天预测模型路径
MODEL_CLOUDY=backend/tools/model/cloudy_model.h5


# ==============================
# 文件与会话配置
# ==============================

# 文件上传、导入和导出目录
FILE_DIR=backend/temp/file

# 测试或开发阶段使用的会话标识
SESSION_ID_TEST=
SESSION_ID_USER=

# AskUser 等待用户回复的超时时间，单位：秒
ASK_USER_TIMEOUT=120


# ==============================
# Web 服务配置
# ==============================

# 允许访问后端的前端地址，多个地址使用英文逗号分隔
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173


# ==============================
# JWT 认证配置
# ==============================

# 必须使用随机生成的长密钥，生产环境建议至少 32 位
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters

# Token 有效期，单位：秒
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=3600